{
    "version": 2,
    "framework": null,
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.6.0"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/user/assets/(.*)",
            "dest": "/public/user/assets/$1"
        },
        {
            "src": "/admin/assets/(.*)",
            "dest": "/public/admin/assets/$1"
        },
        {
            "src": "/products_images/(.*)",
            "dest": "/public/products_images/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
