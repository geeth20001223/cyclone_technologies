{
    "version": 2,
    "builds": [
        {
            "src": "api/index.php",
            "use": "vercel-php@0.9.0"
        }
    ],
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/user/assets/(.*)",
            "dest": "/public/user/assets/$1"
        },
        {
            "src": "/admin/assets/(.*)",
            "dest": "/public/admin/assets/$1"
        },
        {
            "src": "/products_images/(.*)",
            "dest": "/public/products_images/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}